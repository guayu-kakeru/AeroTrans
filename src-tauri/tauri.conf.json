{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroTrans",
  "version": "0.1.0",
  "identifier": "com.guayu.aerotrans",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": false,
    "targets": "all"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AeroTrans",
        "width": 1080,
        "height": 760,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
